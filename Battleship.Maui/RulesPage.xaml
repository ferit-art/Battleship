<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Battleship.Maui.RulesPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#020B14">

    <Grid
        RowDefinitions="Auto, *, Auto, Auto"
        Padding="24, 60, 24, 40">

        <!-- TITLE HEADER -->
        <!-- Row 1 in the grid layout -->
        <VerticalStackLayout
            Margin="0, 7, 0, 0"
            Grid.Row="0"
            Spacing="8"
            HorizontalOptions="Center">

            <Label
                Text="RULES"
                FontSize="42"
                FontAttributes="Bold"
                TextColor="#E0F7FA"
                HorizontalOptions="Center"
                CharacterSpacing="2" />

            <Label
                Text="are as follows:"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="#80DEEA"
                HorizontalOptions="Center"
                CharacterSpacing="2" />
        </VerticalStackLayout>

        <!-- RULES(IN TEXT) -->
        <!-- Row 2 -->
        <VerticalStackLayout
            Grid.Row="1"
            VerticalOptions="Center"
            Spacing="20"
            Padding="20, 0">

            <!-- RUlES LABEL LAYERS -->
            <Grid
                HeightRequest="400"
                WidthRequest="320"
                HorizontalOptions="Center">

                <!-- LABEL BACKGROUND -->
                <Image
                    Source="label_img.jpg"
                    Aspect="Fill"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

                <!-- LABEL(IN TEXT) -->
                <VerticalStackLayout
                    Spacing="15"
                    Padding="30, 50"
                    VerticalOptions="Center">
                    <Label
                        Text="There are five types of ships in the fleet:&#10;&#x25AA; Carrier — 5 cells&#10;&#x25AA; Battleship — 4 cells&#10;&#x25AA; Destroyer — 3 cells&#10;&#x25AA; Submarine — 3 cells&#10;&#x25AA; Patrol Boat — 2 cells"
                        HorizontalTextAlignment="Start"
                        TextColor="#E0F7FA"
                        FontSize="12"
                        LineHeight="1.3">
                    </Label>

                    <Label
                        Text=" Place your ships one at a time in a straight line&#10; Diogonal orientation is not accepted&#10; Try to guess and sink opponent's ships before all of your ships are sunken"
                        TextColor="#E0F7FA"
                        FontSize="12"
                        LineHeight="1.3" />
                    
                    <Label
                        FontAttributes="Bold"
                        Text="First come, first served. A good luck is indeed needed!"
                        TextColor="#E0F7FA"
                        FontSize="12"
                        LineHeight="1.3" />
                </VerticalStackLayout>
            </Grid>
        </VerticalStackLayout>

        <!-- GO BACK BUTTON -->
        <!-- Row 3 -->
        <VerticalStackLayout
            Grid.Row="2"
            VerticalOptions="Center"
            Spacing="20"
            Padding="20, 0">

            <!-- BACK BUTTON LAYERS -->
            <Grid
                WidthRequest="240"
                HorizontalOptions="Center">

                <!-- BUTTON BACKGROUND -->
                <Image
                    Source="button_img.jpg"
                    Aspect="Fill"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

                <!-- GO BACK BUTTON -->
                <Button
                    Text="GO BACK"
                    FontSize="18"
                    FontAttributes="Bold"
                    TextColor="#FFFFFF"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    CornerRadius="8"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    HeightRequest="56"
                    CharacterSpacing="2"
                    SemanticProperties.Hint="Starts the game, making the app to present the next scene"
                    Clicked="OnGoBackClicked" />
            </Grid>
        </VerticalStackLayout>

        <!-- VERSION FOOTER -->
        <!-- Row 4 -->
        <Label
            Grid.Row="3"
            Text="v1.0 • CLASSIC 10x10"
            FontSize="8"
            TextColor="#FFFFFF"
            HorizontalOptions="End"
            CharacterSpacing="1" />
    </Grid>
</ContentPage>