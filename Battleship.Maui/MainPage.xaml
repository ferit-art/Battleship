<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Battleship.Maui.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#020B14">

    <Grid>
        <!-- BACKGROUND LAYER -->   
        <Image
            Source="main_page_bg.jpg"
            Aspect="AspectFill"
            SemanticProperties.Description="Background image for the start menu"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"/>
        
        <!-- UI CONTENT LAYER -->
        <Grid
            RowDefinitions="Auto, *, Auto"
            Padding="24, 60, 24, 40">
            
            <!-- TITLE HEADER -->
            <!-- Row 1 in the grid layout -->
            <VerticalStackLayout 
                Margin="0, 7, 0, 0"
                Grid.Row="0"    
                Spacing="8"
                HorizontalOptions="Center">

            <Label
                Text="BATTLESHIP"
                FontSize="42"
                FontAttributes="Bold"
                TextColor="#E0F7FA"
                HorizontalOptions="Center"
                CharacterSpacing="2"/>
            
            <Label
                Text="FLEET COMMAND SIMULATION"
                FontSize="13"
                FontAttributes="Bold"
                TextColor="#80DEEA"
                HorizontalOptions="Center"
                CharacterSpacing="2"/>
            </VerticalStackLayout>
            
            <!-- NAVIGATION BUTTONS-->
            <!-- Row 2 -->
            <VerticalStackLayout
                Grid.Row="1"
                VerticalOptions="Center"
                Spacing="20"
                Padding="20,0">
                
                <!-- START BUTTON LAYERS -->
                <Grid
                    HeightRequest="65"
                    WidthRequest="240"
                    HorizontalOptions="Center">
                    
                    <!-- BUTTON BACKGROUND -->
                    <Image
                        Source="button_img.jpg"
                        Aspect="Fill"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"/>
                    
                    <!-- THE BUTTON ITSELF(IN TEXT) -->
                    <Button
                        Text="START GAME" 
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CornerRadius="8"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        HeightRequest="56"
                        CharacterSpacing="2"
                        SemanticProperties.Hint="Starts the game, making the app to present the next scene"
                        Clicked="OnStartGameClicked"/>
                </Grid>
            
                <!-- RULES BUTTON LAYERS -->
                <Grid
                    HeightRequest="65"
                    WidthRequest="240"
                    HorizontalOptions="Center">
                    
                    <!-- BUTTON BACKGROUND -->
                    <Image
                        Source="button_img.jpg"
                        Aspect="Fill"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"/>
                    
                    <!-- RULES BUTTON(IN TEXT) -->
                    <Button
                        Text="HOW TO PLAY" 
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CornerRadius="8"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        HeightRequest="56"
                        CharacterSpacing="2"
                        SemanticProperties.Hint="Explains the controlls and rules of the game."
                        Clicked="OnHowToPlayClicked"/>
                </Grid>
            
                <!-- EXIT BUTTON LAYERS -->
                <Grid
                    HeightRequest="65"
                    WidthRequest="240"
                    HorizontalOptions="Center">
                    
                    <!-- BUTTON BACKGROUND -->
                    <Image
                        Source="button_img.jpg"
                        Aspect="Fill"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"/>
                    
                    <!-- EXIT BUTTON(IN TEXT) -->
                    <Button
                        Text="EXIT GAME" 
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CornerRadius="8"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        HeightRequest="56"
                        CharacterSpacing="2"
                        SemanticProperties.Hint="Exits the game."
                        Clicked="OnExitGameClicked"/>
                </Grid>
            </VerticalStackLayout>
            
            <!-- VERSION FOOTER -->
            <!-- Row 3 -->
            <Label
                Grid.Row="2"
                Text="v1.0 • CLASSIC 10x10"
                FontSize="8"
                TextColor="#FFFFFF"
                HorizontalOptions="End"
                CharacterSpacing="1"/>
            </Grid>
    </Grid>
</ContentPage>
