<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Battleship.Maui.DeployPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#020B14">

    <Grid>
        
        <!-- BACKGROUND LAYER -->
        <Image
            Source="deploy_page_bg.jpg"
            Aspect="Fill"
            SemanticProperties.Description="Background image for the deploy page"
            HorizontalOptions="Fill"
            VerticalOptions="Fill" />

        <!-- UI CONTENT LAYER -->
        <Grid
            RowDefinitions="Auto, Auto, Auto, *"
            Padding="20, 30, 20, 40">

            <!-- TITLE HEADER -->
            <!-- Row 1 in the grid layout -->
            <VerticalStackLayout
                Grid.Row="0"
                Spacing="8"
                HorizontalOptions="Center">

                <Label
                    Text="DEPLOYMENT GRID"
                    LineHeight="0.8"
                    FontSize="42"
                    FontAttributes="Bold"
                    TextColor="#E0F7FA"
                    HorizontalTextAlignment="Center"
                    HorizontalOptions="Center"
                    CharacterSpacing="2" />

            </VerticalStackLayout>
            
            <!-- INVENTORY -->
            <!-- Row 2 -->
            <VerticalStackLayout
                Grid.Row="1"
                VerticalOptions="Center"
                Padding="20,5"
                Margin="0, 100, 0, 0">
                
                <Label
                    Text="INVENTORY"
                    TextColor="#E0F7FA"
                    FontAttributes="Bold"
                    CharacterSpacing="1"
                    FontSize="13"/>
            </VerticalStackLayout>
            
            <!-- AVAILABLE SHIPS -->
            <!-- Row 3 -->
            <VerticalStackLayout
                Grid.Row="2"
                Margin="0, 5"
                WidthRequest="360"
                Spacing="20">
                
                <Grid
                    x:Name="ShipInventory"
                    HeightRequest="50"
                    HorizontalOptions="Center">
                    
                </Grid>
                
            </VerticalStackLayout>
            
            <!-- Row 4 -->
            <VerticalStackLayout
                Grid.Row="3"
                Margin="0, 15,0,0"
                HorizontalOptions="Center">
                
                <!-- THE DEPLOYMENT GRID -->
                <Grid
                    x:Name="DeployGrid"
                    WidthRequest="360"
                    HeightRequest="424"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                </Grid>
                
                <!-- DEPLOY BUTTON LAYERS -->
                <Grid
                    Padding="4"
                    HeightRequest="40"
                    WidthRequest="200"
                    HorizontalOptions="Center">
                    
                    <!-- BUTTON BACKGROUND -->
                    <Image
                        Source="button_img.jpg"
                        Aspect="Fill"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"/>
                    
                    <!-- DEPLOY BUTTON(IN TEXT) -->
                    <Button
                        x:Name="DeployBtn"
                        Text="DEPLOY" 
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        CornerRadius="8"
                        InputTransparent="true"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        HeightRequest="56"
                        CharacterSpacing="2"
                        SemanticProperties.Hint="Deploys the fleet into the game and starts the round."
                        Clicked="OnDeployClicked"/>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>