<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Battleship.Maui.FinalPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#020B14">
    
    <Grid>
        <!-- BACKGROUND LAYER -->
        <Image
            Source="final_page_bg.jpg"
            Aspect="Fill"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"/>
        
        <Grid
            RowDefinitions="Auto, Auto, Auto"
            Padding="20, 20, 20, 20">
            
            <!-- Row 1 -->
            <VerticalStackLayout
                Grid.Row="0"
                Margin="27, 31, 0, 0"
                HorizontalOptions="Center">
                
                <!-- BOT GRID -->
                <Grid
                    x:Name="BotGrid"
                    WidthRequest="305"
                    HeightRequest="348">
                </Grid>
            </VerticalStackLayout>
            
            <!-- Row 2 -->
            <VerticalStackLayout
                Grid.Row="1"
                Margin="27, 58, 0, 0"
                HorizontalOptions="Center">
                
                <!-- PLAYER GRID -->
                <Grid
                    x:Name="PlayerGrid"
                    WidthRequest="305"
                    HeightRequest="348">
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>